+static int ReadCharacterWithPeriodicCallback(EditLine *EL, wchar_t *WC) {
+  LineEditor::InternalData *Data = nullptr;
+  if (WC == nullptr)
+    return -1;
+  if (el_get(EL, EL_CLIENTDATA, &Data) != 0 || Data == nullptr ||
+      Data->In == nullptr)
+    return -1;
+
+  const int inputFileDescriptor = ::fileno(Data->In);
+  if (inputFileDescriptor < 0)
+    return -1;
+
+  *WC = L'\0';
+
+  for (;;) {
+    const auto now = Clock::now();
+
+    if (Data->PeriodicCallback != nullptr &&
+        Data->PeriodicCallbackInterval.count() > 0 &&
+        (Data->NextPeriodicCallbackTime == Clock::time_point::min() ||
+         now >= Data->NextPeriodicCallbackTime)) {
+      Data->PeriodicCallback();
+      Data->NextPeriodicCallbackTime = now + Data->PeriodicCallbackInterval;
+    }
+
+    char character = '\0';
+    ssize_t readSize = -1;
+
+#if defined(FIONREAD)
+    int availableByteCount = 0;
+    if (::ioctl(inputFileDescriptor, FIONREAD, &availableByteCount) < 0)
+      return -1;
+    if (availableByteCount > 0) {
+      readSize = ::read(inputFileDescriptor, &character, 1);
+    } else {
+      readSize = 0;
+    }
+#elif defined(F_GETFL) && defined(F_SETFL) && defined(O_NONBLOCK)
+    const int originalFlags = ::fcntl(inputFileDescriptor, F_GETFL, 0);
+    if (originalFlags < 0)
+      return -1;
+
+    const bool wasNonBlocking = (originalFlags & O_NONBLOCK) != 0;
+    if (!wasNonBlocking &&
+        ::fcntl(inputFileDescriptor, F_SETFL, originalFlags | O_NONBLOCK) < 0)
+      return -1;
+
+    readSize = ::read(inputFileDescriptor, &character, 1);
+
+    if (!wasNonBlocking)
+      (void)::fcntl(inputFileDescriptor, F_SETFL, originalFlags);
+#else
+    readSize = ::read(inputFileDescriptor, &character, 1);
+#endif
+
+    if (readSize > 0) {
+      *WC = static_cast<unsigned char>(character);
+      return 1;
+    }
+
+    if (readSize < 0) {
+      if (errno == EAGAIN || errno == EINTR)
+        continue;
+      return -1;
+    }
+
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+}
+
+static void EnablePeriodicCallback(LineEditor::InternalData &Data) {
+  if (Data.UsingPeriodicCallback)
+    return;
+
+  ::el_set(Data.EL, EL_GETCFN, ReadCharacterWithPeriodicCallback);
+  Data.UsingPeriodicCallback = true;
+  Data.NextPeriodicCallbackTime = Clock::time_point::min();
+}
+
+static void DisablePeriodicCallback(LineEditor::InternalData &Data) {
+  if (!Data.UsingPeriodicCallback)
+    return;
+
+  Data.PeriodicCallback = nullptr;
+  Data.PeriodicCallbackInterval = std::chrono::milliseconds{0};
+  Data.NextPeriodicCallbackTime = Clock::time_point::min();
+
+#ifdef EL_BUILTIN_GETCFN
+  ::el_set(Data.EL, EL_GETCFN, EL_BUILTIN_GETCFN);
+#endif
+  Data.UsingPeriodicCallback = false;
+}
