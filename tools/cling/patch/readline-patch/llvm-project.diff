+void LineEditor::setPeriodicCallback(
+    PeriodicCallbackFunction callbackFunction,
+    std::chrono::milliseconds callbackInterval) {
+  if (callbackFunction == nullptr || callbackInterval.count() <= 0) {
+    clearPeriodicCallback();
+    return;
+  }
+
+  Data->PeriodicCallback = callbackFunction;
+  Data->PeriodicCallbackInterval = callbackInterval;
+  Data->NextPeriodicCallbackTime = Clock::time_point::min();
+  EnablePeriodicCallback(*Data);
+}
+
+void LineEditor::clearPeriodicCallback() { DisablePeriodicCallback(*Data); }
+
+bool LineEditor::hasPeriodicCallback() const {
+  return Data->UsingPeriodicCallback;
+}
