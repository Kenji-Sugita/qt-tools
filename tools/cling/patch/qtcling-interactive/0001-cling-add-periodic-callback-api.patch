@@ -877,4 +877,21 @@ namespace cling {
   };
 } // namespace cling
 
+extern "C" {
+#if defined(_WIN32)
+#define CLING_PERIODIC_CALLBACK_EXPORT __declspec(dllexport)
+#else
+#define CLING_PERIODIC_CALLBACK_EXPORT
+#endif
+/// Register a callback that is invoked periodically while the interactive
+/// prompt waits for input. The callback runs on Cling's main thread.
+/// Passing nullptr disables the callback. Non-positive intervals use 100ms.
+CLING_PERIODIC_CALLBACK_EXPORT void
+cling_set_periodic_callback(void (*callbackFunction)(),
+                            int intervalMilliseconds = 100);
+
+/// Disable the periodic callback registered with cling_set_periodic_callback().
+CLING_PERIODIC_CALLBACK_EXPORT void cling_clear_periodic_callback();
+}
+
 #endif // CLING_INTERPRETER_H
