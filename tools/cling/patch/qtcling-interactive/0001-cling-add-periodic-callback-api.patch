 namespace {
   ///\brief Class that specialises the textinput TabCompletion to allow Cling
   /// to code complete through its own textinput mechanism which is part of the
@@ -121,6 +123,35 @@ namespace {
     cling::errs() << "Failed to create command history file\n";
     return {};
   }
+
+  llvm::LineEditor* activeLineEditor = nullptr;
+}
+
+extern "C" void cling_set_periodic_callback(void (*callbackFunction)(),
+                                            int intervalMilliseconds) {
+  if (activeLineEditor == nullptr) {
+    return;
+  }
+
+  if (callbackFunction == nullptr) {
+    activeLineEditor->clearPeriodicCallback();
+    return;
+  }
+
+  if (intervalMilliseconds <= 0) {
+    intervalMilliseconds = 100;
+  }
+
+  activeLineEditor->setPeriodicCallback(
+      callbackFunction, std::chrono::milliseconds{intervalMilliseconds});
+}
+
+extern "C" void cling_clear_periodic_callback() {
+  if (activeLineEditor == nullptr) {
+    return;
+  }
+
+  activeLineEditor->clearPeriodicCallback();
 }
 
