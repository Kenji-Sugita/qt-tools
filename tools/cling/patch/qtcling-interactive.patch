+extern "C" {
+/// Register a callback that is invoked periodically while the interactive
+/// prompt waits for input. The callback runs on Cling's main thread.
+/// Passing nullptr disables the callback. Non-positive intervals use 100ms.
+void cling_set_periodic_callback(void (*callbackFunction)(),
+                                 int intervalMilliseconds = 100);
+
+/// Disable the periodic callback registered with cling_set_periodic_callback().
+void cling_clear_periodic_callback();
+}
+
