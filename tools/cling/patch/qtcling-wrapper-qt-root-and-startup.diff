diff --git a/bin/iqtcling.macos b/bin/iqtcling.macos
index 7600eaf..0c71954 100755
--- a/bin/iqtcling.macos
+++ b/bin/iqtcling.macos
@@ -1,7 +1,8 @@
 #!/bin/sh
 
 #QT_ROOT=/usr/local/qt/Qt/6.10.2/macos
-QT_ROOT=/usr/local/qt/Qt/6.11.0/macos
+DEFAULT_QT_ROOT=/usr/local/qt/Qt/6.11.0/macos
+QT_ROOT=${QTCLING_QT_ROOT:-$DEFAULT_QT_ROOT}
 
 CLING_ROOT=/usr/local/qtcling
 CLING_ROOT=/usr/local/src/cling/build
@@ -11,15 +12,43 @@ CLING_ROOT=/usr/local/src/cling/build
 
 CLING=${CLING_ROOT}/bin/cling
 DEV_ROOT=/usr/local/src/cling
+QT_FRAMEWORK_PATH="${QT_ROOT}/lib"
+QT_CORE_LIBRARY="${QT_FRAMEWORK_PATH}/QtCore.framework/Versions/A/QtCore"
+QT_GUI_LIBRARY="${QT_FRAMEWORK_PATH}/QtGui.framework/Versions/A/QtGui"
+QT_WIDGETS_LIBRARY="${QT_FRAMEWORK_PATH}/QtWidgets.framework/Versions/A/QtWidgets"
+
+if [ ! -d "$QT_ROOT" ]; then
+    echo "qtcling: Qt root not found: $QT_ROOT" >&2
+    echo "qtcling: set QTCLING_QT_ROOT to your Qt installation path." >&2
+    exit 1
+fi
+
+if [ ! -f "$QT_CORE_LIBRARY" ]; then
+    echo "qtcling: QtCore framework library not found under: $QT_FRAMEWORK_PATH" >&2
+    echo "qtcling: set QTCLING_QT_ROOT to a Qt macOS kit directory." >&2
+    exit 1
+fi
+
+PRELOAD_HEADER=$(mktemp "${TMPDIR:-/tmp}/qtcling-preload.XXXXXX.h") || exit 1
+trap 'rm -f "$PRELOAD_HEADER"' EXIT HUP INT TERM
+
+printf '#pragma cling load("%s")\n' "$QT_CORE_LIBRARY" > "$PRELOAD_HEADER"
+printf '#pragma cling load("%s")\n' "$QT_GUI_LIBRARY" >> "$PRELOAD_HEADER"
+printf '#pragma cling load("%s")\n' "$QT_WIDGETS_LIBRARY" >> "$PRELOAD_HEADER"
+
+if [ -z "${QTCLING_STARTUP_FILE+x}" ]; then
+    QTCLING_STARTUP_FILE="${DEV_ROOT}/src/qtgui.cpp"
+fi
+export QTCLING_STARTUP_FILE
 
 exec "${CLING}" \
     --nologo \
     -std=c++2c \
-    -I "${QT_ROOT}/lib/QtCore.framework/Headers" \
-    -I "${QT_ROOT}/lib/QtGui.framework/Headers" \
-    -I "${QT_ROOT}/lib/QtWidgets.framework/Headers" \
+    -I "${QT_FRAMEWORK_PATH}/QtCore.framework/Headers" \
+    -I "${QT_FRAMEWORK_PATH}/QtGui.framework/Headers" \
+    -I "${QT_FRAMEWORK_PATH}/QtWidgets.framework/Headers" \
     -I "${DEV_ROOT}/include" \
     -I "${DEV_ROOT}/src" \
-    -F "${QT_ROOT}/lib" \
-    -include ${DEV_ROOT}/include/preload_qt_macos.h \
+    -F "${QT_FRAMEWORK_PATH}" \
+    -include "$PRELOAD_HEADER" \
     "$@"
