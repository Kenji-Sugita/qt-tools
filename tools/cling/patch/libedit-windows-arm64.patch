index b9f7e19..190130d 100644
--- a/compat/terminfo/buffer.h
+++ b/compat/terminfo/buffer.h
@@ -38,7 +38,14 @@ static inline unsigned clz(ullong val)
 #elif defined (_MSC_VER)
 static inline unsigned clz(ullong val)
 {
-    return (unsigned)_lzcnt_u64(val);
+    unsigned count = 0;
+    if (val == 0)
+        return 64;
+    while ((val & (1ull << 63)) == 0) {
+        val <<= 1;
+        ++count;
+    }
+    return count;
 }
 #endif
 
