@@ -51,8 +51,8 @@
 #undef SIG_IGN
 #undef SIG_ERR
 #undef NSIG
-//#include <signal.h>
-#include "C:\\Program Files (x86)\\Windows Kits\\10\\Include\\10.0.22621.0\\ucrt\\signal.h"
+#include <crtheaders.h>
+#include SIGNAL_H
 #undef NSIG
 #define NSIG 0
 
@@ -267,6 +267,33 @@ sw_process_pending_signals()
  *  if milli_seconds is 0, this function returns 0, its called with 0
  *  to execute any scheduled APCs
 */
+static void (*wait_callback)(void) = NULL;
+static DWORD wait_callback_interval = 0;
+
+void
+w32_set_wait_callback(void (*callback)(void), DWORD interval_milliseconds)
+{
+	wait_callback = callback;
+	wait_callback_interval = callback && interval_milliseconds
+		? interval_milliseconds : 0;
+}
+
+int
+wait_for_any_event_with_callback(HANDLE* events, int num_events,
+	DWORD milli_seconds)
+{
+	if (!wait_callback || !wait_callback_interval)
+		return wait_for_any_event(events, num_events, milli_seconds);
+
+	DWORD slice = milli_seconds == INFINITE
+		? wait_callback_interval
+		: min(milli_seconds, wait_callback_interval);
+	int result = wait_for_any_event(events, num_events, slice);
+	if (result == 0)
+		wait_callback();
+	return result;
+}
+
 int
 wait_for_any_event(HANDLE* events, int num_events, DWORD milli_seconds)
 {
