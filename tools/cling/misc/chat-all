  assert(Data->editLine);

  ::el_set(Data->editLine, EL_PROMPT, ElGetPromptFn);
  ::el_set(Data->editLine, EL_EDITOR, "emacs");
  ::el_set(Data->editLine, EL_HIST, history, Data->history);
  ::el_set(Data->editLine, EL_ADDFN, "tab_complete",
           "Tab completion function", ElCompletionFn);
  ::el_set(Data->editLine, EL_BIND, "\t", "tab_complete", NULL);
  ::el_set(Data->editLine, EL_BIND, "^r", "em-inc-search-prev", NULL);
