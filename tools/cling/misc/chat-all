void UserInterface::runInteractively(bool nologo)
{
  if (!nologo) {
    PrintLogo();
  }

  auto historyFilePath{GetHistoryFilePath()};
  llvm::LineEditor lineEditor("cling", historyFilePath);

  lineEditor.setPeriodicCallback(periodicCallback,
                                 periodicCallbackUserData,
                                 periodicCallbackIntervalMilliseconds);

  std::string prompt("[cling]$ ");

  if (const char* historySizeEnvironmentVariable =
          std::getenv("CLING_HISTSIZE")) {
    const size_t historySize =
        std::strtoull(historySizeEnvironmentVariable, nullptr, 0);
    lineEditor.setHistorySize(historySize);
  }

  lineEditor.setPrompt(prompt);
  lineEditor.setListCompleter(
      ClingListCompleter(m_MetaProcessor->getInterpreter()));

  while (std::optional line = lineEditor.readLine()) {
    // 既存処理
  }

  m_MetaProcessor->getOuts().flush();
