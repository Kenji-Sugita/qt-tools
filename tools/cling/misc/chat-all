readLine() は次のようにします。

std::optional<std::string> LineEditor::readLine() const
{
  ::fprintf(Data->outputFile, "%s", Prompt.c_str());
  ::fflush(Data->outputFile);

  std::string line;
  const int inputFileDescriptor = fileno(Data->inputFile);

  while (true) {
    if (Data->periodicCallback) {
      pollfd inputDescriptor{};
      inputDescriptor.fd = inputFileDescriptor;
      inputDescriptor.events = POLLIN;

      const int pollResult =
          ::poll(&inputDescriptor,
                 1,
                 static_cast<int>(Data->periodicCallbackIntervalMilliseconds));

      if (pollResult == 0) {
        Data->periodicCallback(Data->periodicCallbackUserData);
        continue;
      }

      if (pollResult < 0) {
        if (errno == EINTR) {
          continue;
        }
        return std::nullopt;
      }
    }

    char buffer[64];
    char* result = ::fgets(buffer, sizeof(buffer), Data->inputFile);
    if (!result) {
      if (line.empty()) {
        return std::nullopt;
      }
      return line;
    }

    line.append(buffer);

    if (!line.empty() &&
        (line.back() == '\n' || line.back() == '\r')) {
      break;
    }
  }

  while (!line.empty() &&
         (line.back() == '\n' || line.back() == '\r')) {
    line.pop_back();
  }

  return line;
}
