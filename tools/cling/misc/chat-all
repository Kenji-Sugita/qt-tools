libedit 用の文字入力関数を追加します。
static int ReadCharacterWithPeriodicCallback(EditLine* editLine,
                                             wchar_t* wideCharacter)
{
  LineEditor::InternalData* internalData = nullptr;
  if (el_get(editLine, EL_CLIENTDATA, &internalData) != 0 || !internalData) {
    return -1;
  }

  if (!internalData->periodicCallback) {
    return internalData->builtinGetCharacterFunction(editLine, wideCharacter);
  }

  const int inputFileDescriptor = fileno(internalData->inputFile);

  while (true) {
    pollfd inputDescriptor{};
    inputDescriptor.fd = inputFileDescriptor;
    inputDescriptor.events = POLLIN;

    const int pollResult =
        ::poll(&inputDescriptor,
               1,
               static_cast<int>(
                   internalData->periodicCallbackIntervalMilliseconds));

    if (pollResult > 0) {
      return internalData->builtinGetCharacterFunction(editLine, wideCharacter);
    }

    if (pollResult == 0) {
      internalData->periodicCallback(internalData->periodicCallbackUserData);
      continue;
    }

    if (errno == EINTR) {
      continue;
    }

    return -1;
  }
}
コンストラクターで EL_GETCFN を差し替えます。
LineEditor::LineEditor(StringRef programName,
                       StringRef historyPath,
                       FILE *inputFile,
                       FILE *outputFile,
                       FILE *errorFile)
  : Prompt((programName + "> ").str()),
    HistoryPath(std::string(historyPath)),
    Data(new InternalData)
{
