#include <QDebug>
#include <thread>
#include <atomic>
#include <chrono>

std::atomic<bool> requestProcessEvents{false};
std::atomic<bool> keepWorkerRunning{true};

std::thread eventRequestThread{
    [] {
        using namespace std::chrono_literals;

        while (keepWorkerRunning.load()) {
            std::this_thread::sleep_for(100ms);
            requestProcessEvents.store(true);
            qDebug() << "request";
        }
    }
};

void processPendingEventsIfRequested()
{
    if (!requestProcessEvents.exchange(false)) {
        return;
    }

    qDebug() << "process";
    QApplication::processEvents();
}
