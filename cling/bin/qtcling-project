#!/bin/sh

script_directory_path=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
dev_root=$(CDPATH= cd -- "$script_directory_path/.." && pwd)

if [ -x /usr/bin/env ]; then
    exec /usr/bin/env python3 "$dev_root/bin/qtcling_project.py" "$@"
elif [ -x /bin/env ]; then
    exec /bin/env python3 "$dev_root/bin/qtcling_project.py" "$@"
elif command -v python3 >/dev/null 2>&1; then
    exec "$(command -v python3)" "$dev_root/bin/qtcling_project.py" "$@"
else
    echo "python3 not found." >&2
    exit 1
fi
