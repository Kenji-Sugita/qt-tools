+void LineEditor::setPeriodicCallback(
+    PeriodicCallbackFunction callbackFunction,
+    std::chrono::milliseconds callbackInterval) {
+  Data->CallbackFunction = callbackFunction;
+  Data->CallbackInterval = callbackInterval;
+  Data->UsingPeriodicCallback =
+      callbackFunction != nullptr && callbackInterval.count() > 0;
+#ifdef _WIN32
+  w32_set_wait_callback(callbackFunction,
+                        static_cast<unsigned long>(callbackInterval.count()));
+#endif
+}
+
+void LineEditor::clearPeriodicCallback() {
+  Data->CallbackFunction = nullptr;
+  Data->CallbackInterval = std::chrono::milliseconds{0};
+  Data->UsingPeriodicCallback = false;
+#ifdef _WIN32
+  w32_set_wait_callback(nullptr, 0);
+#endif
+}
+
+bool LineEditor::hasPeriodicCallback() const {
+  return Data->UsingPeriodicCallback;
+}
